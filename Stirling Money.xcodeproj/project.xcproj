      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "StirlingMoneyWidgetsExtension/frameworks",
            "StirlingMoneyWatchWidgetsExtension/frameworks",
          ],
        }, {
          "path": "/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "StirlingMoneyWidgetsExtension/frameworks",
            "StirlingMoneyWatchWidgetsExtension/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
