        { "path": "<PRODUCTS>/Stirling Money.app", "id": "34EB896A3098219F00635974", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Stirling MoneyTests.xctest", "id": "34EB8979309821A100635974", "type": "wrapper.cfbundle", "index": false },
