    { "path": "StirlingMoneyWidgetsExtension.entitlements" },
    { "path": "CLAUDE.md", "target-membership": [ "Stirling Money/resources" ] },
    { "kind": "folder", "path": "Stirling Money", "target-membership": [ "Stirling Money" ] },
    { "kind": "folder", "path": "Stirling MoneyTests", "target-membership": [ "Stirling MoneyTests" ] },
    { "kind": "folder", "path": "Stirling MoneyUITests", "target-membership": [ "Stirling MoneyUITests" ] },
    {
      "kind": "folder",
