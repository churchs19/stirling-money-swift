  "targets": [
    {
      "name": "Stirling Money",
      "id": "34EB89693098219F00635974",
      "product": "Products/Stirling Money.app",
      "product-type": "application",
      "dependencies": [
        "StirlingMoneyWidgetsExtension",
        { "target": "StirlingMoney Watch App", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "StirlingMoney",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
