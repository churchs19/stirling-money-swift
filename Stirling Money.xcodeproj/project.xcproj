          ],
        },
      ],
    },
    { "kind": "folder", "path": "StirlingMoney Watch App", "target-membership": [ "StirlingMoney Watch App" ] },
    { "kind": "folder", "path": "StirlingMoney Watch AppTests", "target-membership": [ "StirlingMoney Watch AppTests" ] },
