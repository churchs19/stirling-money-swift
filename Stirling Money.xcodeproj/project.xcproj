  "files": [
    { "path": "Stirling-Money-Info.plist" },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Stirling Money", "StirlingMoney Watch App", "StirlingMoneyWatchWidgetsExtension", "StirlingMoneyWidgetsExtension" ] },
